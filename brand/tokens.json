  "space": {
    "0": "0.0rem",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1.0rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2.0rem",
    "10": "2.5rem",
    "12": "3.0rem",
    "16": "4.0rem",
    "20": "5.0rem",
    "24": "6.0rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgb(11 15 20 / 0.06)",
    "md": "0 4px 12px -2px rgb(11 15 20 / 0.10)",
    "lg": "0 12px 32px -8px rgb(11 15 20 / 0.16)"
  }
