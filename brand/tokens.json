  "typography": {
    "display": {
      "family": "Switchyard Display",
      "stack": "'Switchyard Display','Space Grotesk',ui-sans-serif,system-ui,sans-serif",
      "file": "SpaceGrotesk-var.woff2",
      "weights": [
        400,
        500,
        600,
        700
      ]
    },
    "body": {
      "family": "Switchyard Sans",
      "stack": "'Switchyard Sans',Inter,ui-sans-serif,system-ui,-apple-system,sans-serif",
      "file": "Inter-var.woff2",
      "weights": [
        400,
        500,
        600,
        700
      ]
    },
    "mono": {
      "family": "Switchyard Mono",
      "stack": "'Switchyard Mono','JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace",
      "file": "JetBrainsMono-var.woff2",
      "weights": [
        400,
        500,
        700
      ]
    }
  },
  "fontSize": {
    "xs": [
      "0.75rem",
      "1rem"
    ],
    "sm": [
      "0.875rem",
      "1.25rem"
    ],
    "base": [
      "1rem",
      "1.5rem"
    ],
    "lg": [
      "1.125rem",
      "1.75rem"
    ],
    "xl": [
      "1.25rem",
      "1.75rem"
    ],
    "2xl": [
      "1.5rem",
      "2rem"
    ],
    "3xl": [
      "1.875rem",
      "2.25rem"
    ],
    "4xl": [
      "2.25rem",
      "2.5rem"
    ],
    "5xl": [
      "3rem",
      "1.1"
    ]
